APP_NAME=Casos Especiales - Tesorería Uninorte
DEBUG=true

# JWT Secret — GENERA UNO ALEATORIO FUERTE Y CAMBIA ESTE VALOR EN PRODUCCIÓN
# Ejemplo de cómo generarlo: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=dev-solo-no-usar-en-produccion-cambiar

# Con DEBUG=false el arranque falla si SECRET_KEY sigue siendo el valor de desarrollo.
# DEBUG=false

# Orígenes del frontend separados por coma (producción: el dominio real de la app)
CORS_ORIGINS=http://localhost:5173
